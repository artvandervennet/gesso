{
  "$description": "Gesso — the design system of Art Van der Vennet (vandervennet.art). W3C Design Tokens format. Shared tokens live here; colours come from the theme recipes in tokens/themes.json. Run `node scripts/build-tokens.mjs` to regenerate css/tokens.css.",
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": {
        "$value": "\"Young Serif\", \"Iowan Old Style\", Georgia, serif",
        "$description": "Headings and the wordmark. One weight, used big."
      },
      "body": {
        "$value": "\"Atkinson Hyperlegible Next\", system-ui, sans-serif",
        "$description": "Everything you read. Drawn by the Braille Institute for legibility."
      },
      "mono": {
        "$value": "\"Atkinson Hyperlegible Mono\", ui-monospace, Menlo, monospace",
        "$description": "Code, commit hashes and branch names only."
      },
      "signature": {
        "$value": "\"Kristi\", \"Young Serif\", cursive",
        "$description": "The artist's signature only: <art-signature>. Never for running text."
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 550
      },
      "bold": {
        "$value": 720
      }
    },
    "size": {
      "$type": "dimension",
      "$description": "Fluid major-third scale (1.25) from an 18px body. Viewport range 360px–1280px.",
      "-1": {
        "$value": "clamp(0.875rem, 0.85rem + 0.1vw, 0.9375rem)"
      },
      "0": {
        "$value": "clamp(1.0625rem, 1.03rem + 0.15vw, 1.125rem)"
      },
      "1": {
        "$value": "clamp(1.25rem, 1.18rem + 0.3vw, 1.4rem)"
      },
      "2": {
        "$value": "clamp(1.5rem, 1.36rem + 0.6vw, 1.75rem)"
      },
      "3": {
        "$value": "clamp(1.8rem, 1.55rem + 1.1vw, 2.2rem)"
      },
      "4": {
        "$value": "clamp(2.2rem, 1.7rem + 2.2vw, 3.4rem)"
      },
      "5": {
        "$value": "clamp(3rem, 1.9rem + 4.8vw, 6.4rem)"
      }
    },
    "leading": {
      "$type": "number",
      "tight": {
        "$value": 1.05
      },
      "snug": {
        "$value": 1.25
      },
      "body": {
        "$value": 1.6
      }
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "4px grid. Named after brush sizes: the bigger the number, the broader the brush.",
    "0": {
      "$value": "0"
    },
    "1": {
      "$value": "0.25rem"
    },
    "2": {
      "$value": "0.5rem"
    },
    "3": {
      "$value": "0.75rem"
    },
    "4": {
      "$value": "1rem"
    },
    "6": {
      "$value": "1.5rem"
    },
    "8": {
      "$value": "2rem"
    },
    "12": {
      "$value": "3rem"
    },
    "16": {
      "$value": "4rem"
    },
    "24": {
      "$value": "6rem"
    },
    "32": {
      "$value": "8rem"
    }
  },
  "radius": {
    "$type": "dimension",
    "$description": "Shape follows material: stretched canvas is nearly square, paint chips are slightly rounded, a dab of paint is never a perfect circle.",
    "canvas": {
      "$value": "2px"
    },
    "chip": {
      "$value": "5px"
    },
    "dab": {
      "$value": "14px 9px 16px 8px / 9px 15px 8px 14px"
    },
    "round": {
      "$value": "999px"
    }
  },
  "shadow": {
    "$type": "shadow",
    "$description": "Shadows describe a physical object, not elevation levels.",
    "canvas-edge": {
      "$value": "1px 1px 0 var(--rule), 2px 2px 0 var(--rule), 3px 3px 0 var(--rule), 4px 4px 0 var(--rule), 4px 6px 14px -4px oklch(20% 0.03 200 / 0.25)"
    },
    "tape": {
      "$value": "0 1px 1.5px oklch(20% 0.03 200 / 0.18)"
    },
    "lifted": {
      "$value": "0 10px 30px -12px oklch(20% 0.03 200 / 0.35)"
    }
  },
  "layout": {
    "$type": "dimension",
    "measure": {
      "$value": "68ch",
      "$description": "Max line length for prose"
    },
    "canvas": {
      "$value": "80rem",
      "$description": "Max page width"
    },
    "gutter": {
      "$value": "clamp(1.25rem, 4vw, 3rem)"
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "dab": {
        "$value": "140ms",
        "$description": "Hover and press feedback"
      },
      "wash": {
        "$value": "400ms",
        "$description": "A background or tint changing colour: a chip being selected, a theme switch"
      },
      "stroke": {
        "$value": "650ms",
        "$description": "A single brushstroke being drawn"
      },
      "drip": {
        "$value": "1100ms",
        "$description": "Paint running down"
      }
    },
    "ease": {
      "$type": "cubicBezier",
      "brush": {
        "$value": [
          0.65,
          0,
          0.25,
          1
        ],
        "$description": "Slow start, confident middle, soft lift-off"
      },
      "drip": {
        "$value": [
          0.5,
          0,
          0.75,
          0
        ],
        "$description": "Accelerates like gravity"
      },
      "settle": {
        "$value": [
          0.16,
          1,
          0.3,
          1
        ]
      }
    }
  },
  "text": {
    "$type": "typography",
    "$description": "Text styles: every piece of text on a page uses one of these. Classes .text-<name> in css/tokens.css; Figma text styles from tokens-studio.json.",
    "wordmark": {
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": "clamp(4.5rem, 2rem + 13vw, 13rem)",
        "fontWeight": 400,
        "lineHeight": 0.9,
        "letterSpacing": "-0.045em"
      },
      "$description": "The site name in the hero. Once per page."
    },
    "heading-1": {
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": "{font.size.5}",
        "fontWeight": 400,
        "lineHeight": 1.05,
        "letterSpacing": "-0.025em"
      },
      "$description": "Page titles."
    },
    "heading-2": {
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": "{font.size.4}",
        "fontWeight": 400,
        "lineHeight": 1.05,
        "letterSpacing": "-0.02em"
      },
      "$description": "Section titles."
    },
    "heading-3": {
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": "{font.size.2}",
        "fontWeight": 400,
        "lineHeight": 1.25,
        "letterSpacing": "-0.01em"
      },
      "$description": "Sub-sections and canvas titles."
    },
    "heading-4": {
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontSize": "{font.size.1}",
        "fontWeight": 720,
        "lineHeight": 1.25,
        "letterSpacing": "0"
      },
      "$description": "Small headings inside a block of text."
    },
    "lead": {
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontSize": "{font.size.1}",
        "fontWeight": 400,
        "lineHeight": 1.5,
        "letterSpacing": "0"
      },
      "$description": "The first paragraph of a section."
    },
    "body": {
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontSize": "{font.size.0}",
        "fontWeight": 400,
        "lineHeight": 1.6,
        "letterSpacing": "0"
      },
      "$description": "Everything people read for a while."
    },
    "small": {
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontSize": "{font.size.-1}",
        "fontWeight": 400,
        "lineHeight": 1.5,
        "letterSpacing": "0"
      },
      "$description": "Captions, footnotes, help text."
    },
    "label": {
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontSize": "{font.size.-1}",
        "fontWeight": 550,
        "lineHeight": 1.25,
        "letterSpacing": "0"
      },
      "$description": "Chips, tags, meta lines, table headers."
    },
    "button": {
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontSize": "{font.size.0}",
        "fontWeight": 720,
        "lineHeight": 1.2,
        "letterSpacing": "0"
      },
      "$description": "Buttons and button-like links."
    },
    "code": {
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontSize": "{font.size.-1}",
        "fontWeight": 400,
        "lineHeight": 1.55,
        "letterSpacing": "0"
      },
      "$description": "Code, commit hashes and branch names."
    },
    "signature": {
      "$value": {
        "fontFamily": "{font.family.signature}",
        "fontSize": "{font.size.3}",
        "fontWeight": 400,
        "lineHeight": 1,
        "letterSpacing": "0"
      },
      "$description": "The signature in the footer, like the name in the corner of a painting. Once per page."
    }
  }
}
